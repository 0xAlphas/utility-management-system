generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model bills {
  id                String     @id
  billNumber        String     @unique
  billingMonth      Int
  billingYear       Int
  issueDate         DateTime   @default(now())
  dueDate           DateTime
  previousReading   Float?
  currentReading    Float?
  consumption       Float      @default(0)
  totalAmount       Float
  paidAmount        Float      @default(0)
  outstandingAmount Float      @default(0)
  status            String     @default("UNPAID")
  remarks           String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime
  customerId        String
  customers         customers  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments          payments[]

  @@unique([customerId, billingMonth, billingYear])
}

model complaints {
  id          String    @id
  subject     String
  description String
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  resolution  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime
  customerId  String
  customers   customers @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model customers {
  id         String       @id
  name       String
  type       String
  contact    String
  email      String?
  address    String
  city       String?
  postalCode String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  bills      bills[]
  complaints complaints[]
  meters     meters[]
}

model meter_readings {
  id           String   @id
  readingValue Float
  readingDate  DateTime @default(now())
  remarks      String?
  recordedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  meterId      String
  meters       meters   @relation(fields: [meterId], references: [id], onDelete: Cascade)
}

model meters {
  id               String           @id
  meterNumber      String           @unique
  installationDate DateTime         @default(now())
  lastReadingDate  DateTime?
  status           String           @default("ACTIVE")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  customerId       String
  utilityTypeId    String
  meter_readings   meter_readings[]
  customers        customers        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  utility_types    utility_types    @relation(fields: [utilityTypeId], references: [id])

  @@unique([customerId, utilityTypeId])
}

model payments {
  id              String   @id
  amount          Float
  paymentDate     DateTime @default(now())
  paymentMethod   String
  referenceNumber String?
  remarks         String?
  recordedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  billId          String
  bills           bills    @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model staff {
  id           String   @id
  username     String   @unique
  passwordHash String
  name         String
  email        String?  @unique
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model tariffs {
  id            String        @id
  name          String
  minUsage      Float         @default(0)
  maxUsage      Float?
  rate          Float
  fixedCharge   Float         @default(0)
  isActive      Boolean       @default(true)
  effectiveFrom DateTime      @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  utilityTypeId String
  utility_types utility_types @relation(fields: [utilityTypeId], references: [id])
}

model utility_types {
  id          String    @id
  name        String    @unique
  description String?
  unit        String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  meters      meters[]
  tariffs     tariffs[]
}
