generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model bill {
  id                String     @id
  billNumber        String     @unique
  billingMonth      Int
  billingYear       Int
  issueDate         DateTime   @default(now())
  dueDate           DateTime
  previousReading   Float?
  currentReading    Float?
  consumption       Float      @default(0)
  totalAmount       Float
  paidAmount        Float      @default(0)
  outstandingAmount Float      @default(0)
  status            String     @default("UNPAID")
  remarks           String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime
  customerId        String
  customer          customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments          payment[]

  @@unique([customerId, billingMonth, billingYear])
  @@map("bills")
}

model complaint {
  id          String    @id
  subject     String
  description String
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  resolution  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime
  customerId  String
  customer    customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("complaints")
}

model customer {
  id         String       @id
  name       String
  type       String
  contact    String
  email      String?
  address    String
  city       String?
  postalCode String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  bills      bill[]
  complaints complaint[]
  meters     meter[]

  @@map("customers")
}

model meterReading {
  id           String   @id
  readingValue Float
  readingDate  DateTime @default(now())
  remarks      String?
  recordedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  meterId      String
  meter        meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@map("meter_readings")
}

model meter {
  id               String          @id
  meterNumber      String          @unique
  installationDate DateTime        @default(now())
  lastReadingDate  DateTime?
  status           String          @default("ACTIVE")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  customerId       String
  utilityTypeId    String
  readings         meterReading[]
  customer         customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  utilityType      utilityType     @relation(fields: [utilityTypeId], references: [id])

  @@unique([customerId, utilityTypeId])
  @@map("meters")
}

model payment {
  id              String   @id
  amount          Float
  paymentDate     DateTime @default(now())
  paymentMethod   String
  referenceNumber String?
  remarks         String?
  recordedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  billId          String
  bill            bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model staff {
  id           String   @id
  username     String   @unique
  passwordHash String
  name         String
  email        String?  @unique
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@map("staff")
}

model tariff {
  id            String      @id
  name          String
  minUsage      Float       @default(0)
  maxUsage      Float?
  rate          Float
  fixedCharge   Float       @default(0)
  isActive      Boolean     @default(true)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  utilityTypeId String
  utilityType   utilityType @relation(fields: [utilityTypeId], references: [id])

  @@map("tariffs")
}

model utilityType {
  id          String    @id
  name        String    @unique
  description String?
  unit        String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  meters      meter[]
  tariffs     tariff[]

  @@map("utility_types")
}
